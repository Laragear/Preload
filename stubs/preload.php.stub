<?php

@autoload

$fileHandle = fopen('@file', 'r');

if ($fileHandle === false) {
    $exception =  new \RuntimeException("Unable to open list [@file]");

    \fwrite(\STDERR, "Error: {$exception->getMessage()}");

    throw $exception;
}

try {
    $i = 0;

    while (($file = fgets($fileHandle)) !== false) {
        $i++;
        try {
            if (!(\is_file($file) && \is_readable($file))) {
                @failure
            }

            @mechanism;
        } catch (\Throwable $previous) {
            $exception = new \RuntimeException(
                "Preloader Script has stopped with an error on #$i file: [$file]", $previous->getCode(), $previous
            );

            \fwrite(\STDERR, "Error: {$exception->getMessage()}");

            throw $exception;
        }
    }
} finally {
    fclose($fileHandle);
    unset($file, $fileHandle, $i);
}
